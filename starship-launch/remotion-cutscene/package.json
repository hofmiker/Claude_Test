{
  "name": "starship-launch-remotion-cutscene",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion render pipeline that reproduces the starship-launch cinematic (countdown through moon touchdown) as an exported MP4.",
  "scripts": {
    "preview": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts StarshipCutscene out/starship-cutscene.mp4 --concurrency=1"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290",
    "three": "0.160.1"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.290",
    "@types/react": "18.3.1",
    "@types/three": "0.160.0",
    "typescript": "5.5.4"
  }
}
